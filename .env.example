# Grounded, idea-specific market research with current Google Search results.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback: enrich the research brief with OpenAI.
OPENAI_API_KEY=

# Local defaults. PostgreSQL and Redis can be selected through these URLs when available.
DATABASE_URL=sqlite:///./launchpad.db
REDIS_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional external actions.
GITHUB_TOKEN=
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
